{
  "dns": {
    "servers": [
      {
        "tag": "remote-dns",
        "type": "https",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "domain_resolver": "local-dns",
        "detour": "Proxy"
      },
      {
        "tag": "local-dns",
        "type": "udp",
        "server": "223.5.5.5",
        "detour": "direct"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "2001:2::/48"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "local.example"
        ],
        "action": "route",
        "server": "local-dns"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip"
      }
    ],
    "final": "remote-dns",
    "strategy": "prefer_ipv4"
  },
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local-dns",
    "final": "Proxy",
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "rule_set": [
          "本地分流"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "example.org"
        ],
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "inline",
        "tag": "本地分流",
        "rules": [
          {
            "domain": [
              "local.example"
            ]
          }
        ]
      }
    ]
  },
  "outbounds": [
    {
      "type": "selector",
      "tag": "Proxy",
      "outbounds": [
        "Fast",
        "Backup",
        "Balance",
        "direct"
      ],
      "default": "Fast"
    },
    {
      "type": "urltest",
      "tag": "Fast",
      "outbounds": [
        "东京示例",
        "新加坡示例"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "Backup",
      "outbounds": [
        "东京示例",
        "新加坡示例"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "tolerance": 0
    },
    {
      "type": "urltest",
      "tag": "Balance",
      "outbounds": [
        "东京示例",
        "新加坡示例"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {
      "type": "shadowsocks",
      "tag": "东京示例",
      "server": "tokyo.example",
      "server_port": 8388,
      "method": "aes-128-gcm",
      "password": "synthetic-password"
    },
    {
      "type": "shadowsocks",
      "tag": "新加坡示例",
      "server": "singapore.example",
      "server_port": 8388,
      "method": "aes-128-gcm",
      "password": "synthetic-password"
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ]
}
