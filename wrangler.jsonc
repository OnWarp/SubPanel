{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subpanel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-23",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sub", "/sub/*", "/s", "/s/*", "/.well-known/subpanel-verify", "/.well-known/subpanel-verify/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "REQUIRE_WORKER_SECRETS": "false",
    "REDEMPTION_ROLLOUT_PERCENT": "100"
  },
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "98e99b0f74494d83808c6b54c66a99e2"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subpanel-d1",
      "database_id": "d8360141-8f44-4550-8656-5931231bb020",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "redact_query_string": true,
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "upload_source_maps": true
}
